-    readonly property var providers: GlobalConfig.utilities.vpn.provider.values
+    // Auto-discovered NetworkManager VPN connections, so a tunnel created in
+    // nmcli / nm-connection-editor is usable here without being declared a
+    // second time. Refreshed by nmProvidersProc below.
+    property var nmProviders: []
+
+    // Turn nmProvidersProc's "<uuid>\t<name>\t<interface>" lines into provider
+    // entries shaped like the config ones. These are plain objects, not config
+    // nodes: they carry `auto: true`, and every index-based mutation below
+    // refuses them (they have no backing config entry to write to).
+    function parseNmProviders(output: string): var {
+        const out = [];
+        for (const line of output.trim().split("\n")) {
+            if (line.length === 0)
+                continue;
+            const [uuid, name, iface] = line.split("\t");
+            if (!uuid)
+                continue;
+            out.push({
+                id: `nm:${uuid}`,
+                auto: true,
+                uuid: uuid,
+                name: name || uuid,
+                displayName: name || uuid,
+                interface: iface || "",
+                connectCmd: ["nmcli", "con", "up", "uuid", uuid],
+                disconnectCmd: ["nmcli", "con", "down", "uuid", uuid]
+            });
+        }
+        return out;
+    }
+
+    // Live list of providers: the typed config list first (so its entries keep
+    // their indices, which the editing UI addresses them by), then the
+    // auto-discovered ones. An auto entry is dropped when a configured entry
+    // already drives the same interface, so hand-written overrides win instead
+    // of showing up twice.
+    readonly property var providers: {
+        const configured = GlobalConfig.utilities.vpn.provider.values;
+        const taken = configured.map(p => p.interface).filter(i => i.length > 0);
+        return [...configured, ...root.nmProviders.filter(p => !taken.includes(p.interface))];
+    }
 
